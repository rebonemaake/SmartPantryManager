<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9FC"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Suggested Recipes ♡"
        android:textColor="#9B8AE6"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Only recipes you can make right now"
        android:textColor="#D6A6C8"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/textNoRecipes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:text="No recipes match your pantry yet ♡&#10;Add more ingredients to unlock recipes."
        android:textColor="#B99BC0"
        android:textSize="16sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/listSuggestedRecipes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="12dp" />

    <Button
        android:id="@+id/btnBackToPantry"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="6dp"
        android:backgroundTint="#D8C8F0"
        android:text="BACK TO PANTRY"
        android:textColor="#6E6285"
        android:textStyle="bold" />

</LinearLayout>