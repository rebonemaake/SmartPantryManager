<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9FC"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="12dp"
    android:paddingEnd="18dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My Pantry ♡"
        android:textColor="#9B8AE6"
        android:textSize="27sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Everything you have, all in one place"
        android:textColor="#D6A6C8"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/searchPantry"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="#D8C8F0"
        android:hint="Search your pantry..."
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="#5E5670"
        android:textColorHint="#B8A9C2"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Pantry Items"
        android:textColor="#6E6285"
        android:textSize="18sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/listPantryItems"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="30dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/textEmptyPantry"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Your pantry is empty ♡&#10;Add your first ingredient below."
            android:textColor="#B99BC0"
            android:textSize="15sp"
            android:visibility="gone" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSuggestedRecipes"
            android:layout_width="0dp"
            android:layout_height="43dp"
            android:layout_weight="1"
            android:backgroundTint="#CFC1EE"
            android:text="RECIPES ♡"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="43dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="#E3D8F4"
            android:text="SETTINGS"
            android:textColor="#6E6285"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <Button
        android:id="@+id/btnAddItem"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:backgroundTint="#E8B4D9"
        android:text="+  ADD PANTRY ITEM"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>